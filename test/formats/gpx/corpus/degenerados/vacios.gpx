<?xml version="1.0" encoding="UTF-8"?>
<!-- SPECS §17.3-14 y DISENO-INTEROP §3.2: un rte sin rtept y un trk sin trkseg salen con 0 partes;
     un trkseg vacío es una parte con 0 vértices. -->
<gpx version="1.1">
  <rte><name>vacía</name></rte>
  <trk/>
  <trk><trkseg/><trkseg><trkpt lat="1" lon="2"/></trkseg></trk>
</gpx>
