{
  "name": "@cristae/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Binding React de Cristae: componentes tipados sobre los custom elements <cristae-*>, con el DATO por propiedad (sin reconciliación de React en el hot-path).",
  "license": "MIT",
  "peerDependencies": {
    "cristae": "*",
    "react": ">=18"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
